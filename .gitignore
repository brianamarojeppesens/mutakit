__pycache__/
*.py[cod]
node_modules/
.DS_Store
*.log

# Per-machine Claude Code settings; the shared ones belong in .claude/settings.json.
.claude/settings.local.json
# Atomic-write temp files; these appear and vanish mid-write and must never be committed.
.claude/*.tmp.*

# Build output is generated by `npm run build`; the folder itself is kept.
build/*
!build/.gitkeep

# A local Node runtime copied into the repo so the sandboxed dev shell can reach
# it. Never committed — `node` on PATH is the normal arrangement.
.node/

# The assembled Pages site; `npm run site` regenerates it.
_site/
